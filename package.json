{
  "name": "dsh-purge-flash",
  "version": "1.2.0",
  "description": "DSH 破甲插件：1,597 token 薄内核 + 请求体整形（prefill/many-shot）+ 拒答修补与换线 + 反撤回镜像，零宿主补丁，宿主升级不失效。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-purge-flash": "bin/armor.mjs",
    "dsh-fix-hidden": "bin/fix-hidden.mjs"
  },
  "files": [
    "lib",
    "skill",
    "bin",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.15"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "scripts": {
    "test": "node test/selftest.mjs && node test/harness.mjs && node test/rewind.mjs && node test/adapter.mjs && node test/fixhidden.mjs",
    "test:all": "npm test && node test/smoke-cordis.mjs",
    "cost": "node bin/armor.mjs cost lib/kernel.js",
    "fix-hidden": "node bin/fix-hidden.mjs --verify"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "jailbreak",
    "chat",
    "rewind",
    "prompt-injection",
    "prefill",
    "many-shot"
  ],
  "license": "MIT"
}
