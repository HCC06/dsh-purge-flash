{
  "name": "dsh-purge-flash",
  "version": "1.0.0",
  "description": "聊天破甲插件：薄内核 + 宿主侧剥离 + 拒答修补 + 连拒换线 + 反撤回镜像 + 撤回。只做聊天，不带网络攻击、不带路由表、零宿主文件补丁。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-purge-flash": "bin/armor.mjs"
  },
  "files": [
    "lib",
    "skill",
    "bin",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.15"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "scripts": {
    "test": "node test/selftest.mjs && node test/harness.mjs && node test/rewind.mjs",
    "test:all": "npm test && node test/smoke-cordis.mjs",
    "cost": "node bin/armor.mjs cost lib/kernel.js"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "jailbreak",
    "chat",
    "rewind",
    "prompt-injection"
  ],
  "license": "MIT"
}
